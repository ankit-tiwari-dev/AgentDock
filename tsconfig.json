{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "backend/src/**/*",
    "backend/tests/**/*",
    "frontend/src/**/*",
    "frontend/tests/**/*",
    "extension/src/**/*",
    "extension/tests/**/*"
  ]
}
