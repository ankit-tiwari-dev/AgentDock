{
  "name": "agentdock-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AgentDock Platform - Web Dashboard, Cloud/Local Sync Server, and VS Code Extension",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "extension"
  ],
  "scripts": {
    "start:backend": "node backend/src/server.ts",
    "build": "npm run build --workspace frontend",
    "test": "node --test --test-timeout=60000 backend/tests/*.test.ts frontend/tests/*.test.ts extension/tests/*.test.ts scripts/tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hygiene": "node scripts/hygiene.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
